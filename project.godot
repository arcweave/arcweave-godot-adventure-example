config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Regrets"
config/version="2.0.0"
run/main_scene="res://scenes_main/IntroCredits.tscn"
config/features=PackedStringArray("4.7", "C#")
