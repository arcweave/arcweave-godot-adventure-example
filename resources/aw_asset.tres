},
"e1ab6bb6-cb6f-420c-94e6-528fd60b02f2": {
"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>The key to freedom is letting go of them.</p><pre><code>t_key = 2</code></pre>",
"height": 337.0,
"outputs": ["a28d0189-6ef4-49a8-ac70-147913408043"],
"theme": "default",
"title": null,
"width": 322.0,
"x": 9400.0,
"y": 6260.0
},
"e1e50aaf-2940-433a-8d59-1ce2fe533f6e": {
"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>Wow! Where did you get all these?</p>",
"height": 306.0,
"outputs": ["4e352ca5-f2c8-4220-a5e8-880880e85ed3"],
"theme": "cyan",
"title": "<p>Give <span class=\"mention mention-component\" data-id=\"a4412312-b5d7-4826-8335-b51291c6e817\" data-type=\"component\" data-label=\"games magazines\">games magazines</span> to <span class=\"mention mention-component\" data-id=\"2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf\" data-type=\"component\" data-label=\"Andreas\">Andreas</span></p>",
"width": 301.0,
"x": 1500.0,
"y": 8700.0
},
"e2910ffd-fe24-4cea-9f02-b08a577c7c62": {
"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>Maybe, play that game, after all?</p>",
"height": 281.0,
"outputs": ["d0ef8b51-bc47-434a-b632-3c13fab57033"],
"theme": "lightBlue",
"title": "<p>Maybe, play that game, after all?</p>",
"width": 301.0,
"x": 2860.0,
"y": 4700.0
},
"e2b4b9d4-2ba4-4467-b920-b44cb6fef9cd": {
"autoHeight": true,
"components": ["5a015efe-9472-4480-80cd-ede2c35404c3", "d95da3c0-0c71-47bd-9d40-d909dbfaaeef"],
"content": null,
"height": 181.0,
"outputs": ["bf0512f4-f2e6-4c1d-a7a9-212d2e33d8fa"],
"theme": "cyan",
"title": "<p><span class=\"mention mention-component\" data-id=\"5a015efe-9472-4480-80cd-ede2c35404c3\" data-type=\"component\" data-label=\"examine\">examine</span> <span class=\"mention mention-component\" data-id=\"d95da3c0-0c71-47bd-9d40-d909dbfaaeef\" data-type=\"component\" data-label=\"Amstrad 6128\">Amstrad 6128</span> </p>",
"width": 301.0,
"x": 9980.0,
"y": 10420.0
},
"e31b3474-aa90-4e4d-b904-1e11f8fa8cb7": {
"assets": {
