}
},
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>Quit this demo and go write your own game or something!</p>",
"height": 401.0,
"outputs": ["0fbed3c4-288c-4c22-ad18-cbba4f0f785d"],
"theme": "default",
