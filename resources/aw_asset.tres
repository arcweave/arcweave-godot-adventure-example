"y": 11460.0
},
"8ad66265-0e9d-4ea1-a66e-904e26178c2d": {
"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>Being in denial will keep you here forever.</p>",
"height": 290.0,
"outputs": ["59362d7d-1124-454c-876c-b3c97f0cce3f"],
"theme": "lightBlue",
"title": "<p>Being in denial 2 (Direct)</p>",
"width": 321.0,
"x": 6420.0,
"y": 7620.0
},
"8b5b539b-6a9b-41d8-8bab-9f8ddc72463f": {
"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>Adventure games were always released for Amiga 500 and IBM compatibles. Never for Amstrad 6128.</p>",
"height": 321.0,
"outputs": ["f7509fb3-4df4-401a-91e2-41e9a4029133"],
"theme": "default",
"title": null,
"width": 301.0,
"x": 4740.0,
