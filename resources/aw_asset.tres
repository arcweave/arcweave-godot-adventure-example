"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>It seems like it.</p>",
"height": 283.0,
"outputs": ["aaffc81f-e38c-4461-b95f-03684fbc00f8"],
"theme": "default",
"title": null,
"width": 301.0,
"x": 5460.0,
"y": 4000.0
},
"89e6af7f-c084-4172-b1d7-1525b43727c0": {
"assets": {
"cover": {
