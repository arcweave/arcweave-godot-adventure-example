}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>It is you who must keep them.</p>",
"height": 283.0,
"outputs": ["baff4be6-59a4-4675-b3e2-000b1a05ff64"],
"theme": "default",
"title": null,
"width": 301.0,
