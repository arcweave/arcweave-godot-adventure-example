}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7", "f5297f72-36ac-4047-8236-dd23d1da3de3"],
"content": "<p>Aargh... Everything is so dreamy, here.</p>",
"height": 284.0,
"outputs": ["d65ac978-a1dc-450e-bb9a-d5b0c9c31908"],
"theme": "lightBlue",
"title": "<p>Too dreamy...</p>",
"width": 301.0,
