},
"170e46b2-6d06-4aa3-8165-0787933bafc1": {
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>\"Remember to breathe.\"</p>",
"height": 121.0,
"outputs": ["94c5555b-1d2a-4d3b-91cb-82c5a1b3afc2"],
"theme": "default",
"title": null,
"width": 301.0,
