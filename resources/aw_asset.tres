}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>Biggest number wins.</p>",
"height": 290.0,
"outputs": ["0de0259f-c3d4-45db-aed4-989a9f2d8528"],
"theme": "default",
