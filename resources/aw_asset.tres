"x": 1880.0,
"y": 4120.0
},
"be8d9670-c10f-40a6-ba32-ab623e5b4e44": {
"autoHeight": true,
"components": [],
"content": "<p>You can find the Godot project files in <a href=\"https://github.com/Arcweave/arcweave-godot-adventure-example\" target=\"__blank\" rel=\"noopener noreferrer nofollow\" title=\"https://github.com/Arcweave/arcweave-godot-adventure-example\" onclick=\"event.stopPropagation()\">this repo</a>. Just download and import them to Godot.</p>",
"height": 140.0,
"outputs": ["3fb98cd1-dd9e-4a1b-9b58-938526ae31ee"],
"theme": "pink",
