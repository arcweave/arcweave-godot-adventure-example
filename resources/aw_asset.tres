}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>Is there something stopping you from accomplishing things?</p>",
"height": 304.0,
"outputs": ["5966511b-1aa7-4c90-831d-3a50300b30d8"],
"theme": "default",
"title": "<p>Something stopping you?</p>",
