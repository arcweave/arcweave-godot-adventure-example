},
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>Well, that was it.</p>",
"height": 401.0,
"outputs": ["f9e58f14-99be-4feb-a90e-1ad2a076c1c4"],
"theme": "blue",
"title": "<p>Finale dialogue</p>",
"width": 301.0,
