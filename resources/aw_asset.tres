"content": null,
"height": 181.0,
"outputs": ["1c9dbeff-ac2f-4ed1-b484-3fcb6272d443"],
"theme": "cyan",
"title": "<p><span class=\"mention mention-component\" data-id=\"5a015efe-9472-4480-80cd-ede2c35404c3\" data-type=\"component\" data-label=\"examine\">examine</span> <span class=\"mention mention-component\" data-id=\"8f930cc8-f93a-4932-93ed-bf8f837487f8\" data-type=\"component\" data-label=\"grand piano\">grand piano</span> </p>",
"width": 301.0,
"x": 9980.0,
"y": 10220.0
},
"88b0767d-0600-4322-85db-e65f4869c4ba": {
"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>OK, you can't be forced into such a process.</p>",
"height": 303.0,
"outputs": ["5a570e75-a21a-48ce-829b-d72f33b67472"],
"theme": "default",
"title": null,
"width": 301.0,
"x": 3540.0,
"y": 3860.0
},
"88b99695-f921-4d3c-aa28-0e8276c6149b": {
"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>A locked door symbolizes things that stop us from moving on.</p>",
"height": 303.0,
"outputs": ["07904d07-fac3-4620-a704-dfe30117f139"],
"theme": "default",
"title": null,
"width": 301.0,
"x": 8700.0,
"y": 6280.0
},
"89438d1b-f435-4600-914d-2ddc15b8e48f": {
"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf", "1ff6f2bd-7675-4f5e-958e-3d6ca5f102c2"],
"content": "<pre><code>andreasRoll = roll(100)</code></pre><pre><code>show(andreasRoll, \"!\")</code></pre>",
"height": 342.0,
"outputs": ["09dcf522-6aa5-4490-8277-fc0da5bba261"],
"theme": "pink",
"title": "<p>Andreas's roll</p>",
"width": 301.0,
"x": 7460.0,
"y": 4380.0
},
"895683a2-4fca-43fd-aa83-fde7e46fab43": {
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7", "f5297f72-36ac-4047-8236-dd23d1da3de3"],
"content": "<p>\"Left-click on one to use it. Right-click to examine it.\"</p>",
"height": 201.0,
"outputs": [],
"theme": "cyan",
"title": "<p>What do I do with my stuff?</p>",
"width": 301.0,
"x": 14720.0,
"y": 11720.0
},
"89a0a6ba-43f1-4a9c-8352-9c11eb04d367": {
"assets": {
"cover": {
"id": "021fa9d6-8342-475a-b53a-9a465de67a25"
}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>I need some help with all this.</p>",
"height": 283.0,
"outputs": ["9bb14fd9-5c4a-4ff4-aba4-7fdcaddd0bc7"],
"theme": "default",
"title": "<p>I need some help.</p>",
"width": 301.0,
"x": 4800.0,
"y": 2520.0
},
