}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>It was my mum's fault.</p>",
"height": 284.0,
"outputs": ["991f1e75-c01e-4a54-a683-beb008c96bf5"],
"theme": "default",
"title": "<p>It was my mum's fault.</p>",
