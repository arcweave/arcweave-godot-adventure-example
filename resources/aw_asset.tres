}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>I would play games on it. Good old early-90s games.</p>",
"height": 304.0,
"outputs": ["b762b82d-5a73-40f6-a716-ec69619fb4c7"],
"theme": "default",
"title": "<p>I would play games on it.</p>",
"width": 301.0,
