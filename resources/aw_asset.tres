}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>Those are documents of your own inner strength and creativity.</p>",
"height": 303.0,
"outputs": ["20dbda4b-0ed4-498f-b541-b7eebf1b14ca"],
"theme": "default",
"title": null,
"width": 301.0,
