},
"78b6ec2d-4d9d-4b43-8a26-2b333eec5d95": {
"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>I think I know this guy from somewhere.</p>",
"height": 284.0,
"outputs": ["4f81b5ff-e360-41cb-831c-accf0830ac7d"],
"theme": "pink",
"title": "<p><span class=\"mention mention-component\" data-id=\"2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf\" data-type=\"component\" data-label=\"Andreas\">Andreas</span> examine reply</p>",
