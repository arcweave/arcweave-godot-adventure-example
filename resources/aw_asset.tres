}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>Examine them carefully, for the memories to awaken.</p>",
"height": 303.0,
"outputs": ["f9c3e867-07e5-40c2-a196-45228207c7c4"],
"theme": "default",
"title": null,
"width": 299.0,
