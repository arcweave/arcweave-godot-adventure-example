}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>And I'm wise.</p>",
"height": 283.0,
"outputs": ["42bb8b97-5b4a-4950-afe2-a971c30bb1cc", "ab087816-5b33-4d30-97c4-353a13e5e603", "4c92a9fc-f552-4494-bd41-197cfe024ff9"],
