"186a4218-8b60-414e-9b81-030bb31d78a8": {
"autoHeight": true,
"components": [],
"content": "<p>This project uses Arcweave's plugin for Godot, which you can find in the <a href=\"https://godotengine.org/asset-library/asset/1601\" target=\"__blank\" rel=\"noopener noreferrer nofollow\" title=\"https://godotengine.org/asset-library/asset/1601\" onclick=\"event.stopPropagation()\">Godot Asset Library</a>.</p>",
"height": 140.0,
"outputs": ["38822e7c-6130-43c5-9ea3-a53ee56a3537"],
"theme": "pink",
"title": "<p>The Plugin</p>",
"width": 301.0,
"x": 10200.0,
"y": 10360.0
},
"195fb2b6-c572-42f3-b926-be5919ee0010": {
"autoHeight": true,
"components": ["7dc10d72-cac3-475e-9076-5c984e2884b0", "2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": null,
"height": 181.0,
"outputs": ["92adce3e-165c-412a-a2d2-31b6e52a2132"],
"theme": "cyan",
"title": "<p>Give <span class=\"mention mention-component\" data-id=\"7dc10d72-cac3-475e-9076-5c984e2884b0\" data-type=\"component\" data-label=\"key\">key</span> to <span class=\"mention mention-component\" data-id=\"2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf\" data-type=\"component\" data-label=\"Andreas\">Andreas</span></p>",
"width": 301.0,
"x": 10320.0,
"y": 12180.0
},
"1a513314-bd06-464c-8df6-c9a264d07ce8": {
"assets": {
"cover": {
