"assets": {
"cover": {
"id": "9cfd36f5-8981-4bc2-b576-49806f16f7ce"
}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>It's where we chill.</p>",
"height": 283.0,
"outputs": ["2d44fc54-912b-4c4e-9823-7ea8f2d9dc75"],
"theme": "default",
"title": null,
"width": 301.0,
