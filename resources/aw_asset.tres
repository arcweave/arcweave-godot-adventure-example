}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>Somebody thought it would be funny--or meaningful in some way?-- for me to just be here.</p>",
"height": 324.0,
"outputs": ["341992d5-81ba-4b14-b1d7-303fd66a9551"],
"theme": "default",
"title": null,
"width": 301.0,
