"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf", "f5297f72-36ac-4047-8236-dd23d1da3de3"],
"content": "<p>It will go well with all those <span class=\"mention mention-component\" data-id=\"a4412312-b5d7-4826-8335-b51291c6e817\" data-type=\"component\" data-label=\"games magazines\">games magazines</span> you already gave me.</p>",
"height": 318.0,
"outputs": ["5acabd4e-485a-4e53-b245-9ad35a76f5f6"],
"theme": "default",
"title": null,
"width": 281.0,
"x": 4360.0,
"y": 7180.0
},
"e18e88d1-e0f9-46a7-92ba-e0a1d38adcd6": {
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>\"GAME INSTRUCTIONS\"</p>",
"height": 181.0,
"outputs": ["8fae8688-8fd0-40f9-8db8-55e010a83c25", "070057a6-15c0-4785-8449-66689bd1ef29", "149004ac-6e05-4491-a8a8-bc40274ba29e"],
