"content": "<p>A whole world of fiction is nothing but a wrapping around the central protagonist.</p>",
"height": 341.0,
"outputs": ["f870a1d3-c8f9-4b87-8547-8d6c9bb3023d"],
"theme": "default",
"title": null,
"width": 301.0,
"x": 6240.0,
"y": 7820.0
},
