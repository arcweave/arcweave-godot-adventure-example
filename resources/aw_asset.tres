"outputs": ["05a835be-5f86-45d8-b3ce-e4abc586e6ee"],
"theme": "cyan",
"title": "<p><span class=\"mention mention-component\" data-id=\"ef85094c-2389-4ee6-9f5c-051aea3a64a1\" data-type=\"component\" data-label=\"handle\">handle</span> <span class=\"mention mention-component\" data-id=\"d95da3c0-0c71-47bd-9d40-d909dbfaaeef\" data-type=\"component\" data-label=\"Amstrad 6128\">Amstrad 6128</span> </p>",
