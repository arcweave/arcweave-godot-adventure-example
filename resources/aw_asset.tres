"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7", "f5297f72-36ac-4047-8236-dd23d1da3de3"],
"content": "<p>I can always come back and read it again later.</p>",
"height": 201.0,
"outputs": [],
"theme": "default",
