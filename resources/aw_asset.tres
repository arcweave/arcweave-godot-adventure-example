}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>Don't be silly. This is a game.</p>",
"height": 283.0,
"outputs": ["386722e5-4fe6-4229-a778-9bf7b9e84044"],
"theme": "default",
"title": null,
