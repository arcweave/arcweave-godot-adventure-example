}
},
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>See you!</p>",
"height": 401.0,
"outputs": ["014ffd18-7173-49a4-96d3-aabc163e0eb9"],
"theme": "default",
"title": null,
"width": 301.0,
"x": 5492.0,
