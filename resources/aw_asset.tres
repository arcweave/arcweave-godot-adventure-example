}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>What about all the other doors?</p>",
"height": 284.0,
"outputs": ["c6fd6134-1d60-4862-ad74-00660fc9bb21"],
"theme": "default",
"title": "<p>What about all the other doors?</p>",
"width": 301.0,
"x": 6460.0,
