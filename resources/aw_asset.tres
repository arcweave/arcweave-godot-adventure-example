}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>What is this place?</p>",
"height": 288.0,
"outputs": ["35c3c8af-60f6-4d70-981c-1661c46c573b"],
"theme": "default",
"title": "<p>What is this place?</p>",
