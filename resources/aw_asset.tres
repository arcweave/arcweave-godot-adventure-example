}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>We don't have time for hard inner work and years of therapy.</p>",
"height": 308.0,
"outputs": ["a2873ba8-1202-470c-aebb-ca6cd4036792"],
"theme": "default",
"title": "<p style=\"margin-left: 0px\">No time for therapy</p>",
"width": 301.0,
"x": 5760.0,
"y": 2340.0
},
"4151b7da-3074-46f5-944b-cba6efea0f4d": {
"assets": {
"cover": {
