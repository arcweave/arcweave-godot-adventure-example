},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>The Nemesis and/or Villain and/or Antagonist?</p>",
"height": 326.0,
"outputs": ["eb8ebf37-c943-4a6d-bc2b-f7bf24869b90"],
"theme": "default",
"title": "<p>The Nemesis and/or Villain and/or Antagonist?</p>",
