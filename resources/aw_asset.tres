}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>IBM compatibles were picking up.</p>",
"height": 283.0,
"outputs": ["93ca7f8f-b923-44ee-b24f-ac97df16807b"],
