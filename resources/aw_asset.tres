}
},
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>You are an NPC and you KNOW it?</p>",
"height": 321.0,
"outputs": ["ed20e11f-2e5e-493c-993e-2f1e87d9958d"],
"theme": "default",
"title": "<p>You are an NPC and you KNOW it?</p>",
