"x": 10760.0,
"y": 11460.0
},
"78dd6e96-8038-499c-988c-32c95ef253be": {
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7", "f5297f72-36ac-4047-8236-dd23d1da3de3"],
"content": "<p>I don't see anything special about that.</p>",
"height": 181.0,
"outputs": [],
"theme": "default",
"title": null,
"width": 301.0,
"x": 13700.0,
"y": 12760.0
},
"7a432781-639c-41fa-9bec-7973aeb5e418": {
"assets": {
