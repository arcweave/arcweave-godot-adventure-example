}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>Probably in some private collection.</p>",
"height": 306.0,
"outputs": ["12c9307a-1a6d-4259-954b-55bfe23abb26"],
"theme": "default",
"title": "<p>Probably in some private collection.</p>",
"width": 301.0,
