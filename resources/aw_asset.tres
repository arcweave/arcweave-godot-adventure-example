}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>So, is there anything I can help you with?</p>",
"height": 306.0,
"outputs": ["e6f4cc67-b98e-40a1-9f24-0efc57314141"],
"theme": "default",
"title": null,
