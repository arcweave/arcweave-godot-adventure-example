"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>If only life was so simple.</p>",
"height": 181.0,
"outputs": ["0316d33f-9bd8-4cca-b258-c6fc7b0229eb"],
"theme": "default",
"title": null,
"width": 301.0,
