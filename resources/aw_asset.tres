"theme": "lightBlue",
"title": "<p>Examine <span class=\"mention mention-component\" data-id=\"a4412312-b5d7-4826-8335-b51291c6e817\" data-type=\"component\" data-label=\"games magazines\">games magazines</span> 2</p>",
"width": 301.0,
