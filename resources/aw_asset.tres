"assets": {
"cover": {
"id": "021fa9d6-8342-475a-b53a-9a465de67a25"
}
},
"autoHeight": true,
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>Somebody has it in a display case, next to an aquarium with lion fish.</p>",
"height": 303.0,
"outputs": ["07f609ed-67f0-4926-94d8-81e73920c297"],
"theme": "default",
"title": null,
"width": 301.0,
"x": 4940.0,
"y": 6180.0
},
