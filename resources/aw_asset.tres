}
},
"autoHeight": true,
"components": ["2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf"],
"content": "<p>Indeed, everyone is the protagonist in their own story.</p>",
"height": 304.0,
"outputs": ["668e669f-4221-4adf-986a-8a88f3bb103b"],
"theme": "lightBlue",
"title": "<p>Everyone is protagonist 2</p>",
"width": 301.0,
