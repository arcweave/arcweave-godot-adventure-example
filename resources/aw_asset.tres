"content": null,
"height": 181.0,
"outputs": ["126e7f2b-8c04-41ac-b7fe-82fea71d8e59"],
"theme": "purple",
"title": "<p>Give irrelevant to <span class=\"mention mention-component\" data-id=\"2d1e3aaa-d1a3-4565-a540-c0fb9853e2cf\" data-type=\"component\" data-label=\"Andreas\">Andreas</span></p>",
