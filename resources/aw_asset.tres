"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7", "f5297f72-36ac-4047-8236-dd23d1da3de3"],
"content": "<p>Hm.</p>",
"height": 283.0,
"outputs": ["e01c232a-4e65-4f14-8900-2012d76a2b98"],
"theme": "default",
"title": null,
"width": 301.0,
