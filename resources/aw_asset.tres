}
},
"components": ["2cc43715-13b0-4cad-92d7-5b4f61fe66a7"],
"content": "<p>Take them. They're yours.</p>",
"height": 301.0,
"outputs": ["50ee8aa4-4208-4cf9-b8d2-cea6903481d2"],
